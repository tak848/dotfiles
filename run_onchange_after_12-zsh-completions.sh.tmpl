#!/bin/bash
set -euo pipefail

# 起動時に eval すると遅い zsh の補完を、ファイルに書き出して zcompile しておく。
#
# pup の補完は 3.7MB あり、.zshrc で eval "$(pup completions zsh)" すると起動のたびに 10 秒近く
# 構文解析していた。zcompile も同じくらい（手元で 9 秒）かかるので、シェルの起動中ではなく
# pup のバージョンが変わったときにここで一度だけ作る。.zshrc はこのファイルを fpath に足して
# compdef で登録し、補完を使うときに .zwc から読み込む（.zwc なら読み込みは一瞬で終わる）。
#
# task / temporal / mise の補完は小さいが、生成のためにコマンドを起動するだけで 1 つあたり
# 10〜60 ms かかっていた（PR の zsh-startup の計測）。出力はツールのバージョンだけで決まるので、
# pup と同じくここで書き出し、.zshrc では使うときに読み込む。gh も同じ理由でここで書き出す。
#
# 次の行は、各ツールのバージョンが変わったときだけこのスクリプトを走らせるためのもの。
# pup: {{ include "dot_config/mise/config.toml" | regexFind `(?m)^"aqua:DataDog/pup".*$` }}
# task: {{ include "dot_config/mise/config.toml" | regexFind `(?m)^"aqua:go-task/task".*$` }}
# temporal: {{ include "dot_config/mise/config.toml" | regexFind `(?m)^"aqua:temporalio/cli".*$` }}
# gh: {{ include "dot_config/mise/config.toml" | regexFind `(?m)^"aqua:cli/cli".*$` }}
# mise: {{ include ".mise-bootstrap-version" | regexFind `(?m)^MISE_VERSION=.*$` }}
#
# 置き場所は XDG_CACHE_HOME ではなく XDG_DATA_HOME にしている。次にバージョンが変わるまで作り直さないので、
# キャッシュとして消されると、それまで補完が無くなるため。

{{ template "path-setup.tmpl" . }}

comp_dir="${XDG_DATA_HOME}/zsh/completions"
mkdir -p "$comp_dir"
tmp_dir="$(mktemp -d "${comp_dir}/.tmp.XXXXXX")"
trap 'rm -rf -- "$tmp_dir"' EXIT

# 使い方: generate <補完関数の名前> <コマンド> <引数...>
# コマンドが無ければ、前に書き出したものを消す
generate() {
    local name="$1"
    shift
    if command -v "$1" &> /dev/null && command -v zsh &> /dev/null; then
        echo "$1 の zsh 補完を生成中..."
        "$@" > "${tmp_dir}/${name}"
        zsh -fc 'zcompile "$1"' zcompile "${tmp_dir}/${name}"
        # zsh は _xxx と _xxx.zwc のうち新しいほうを読む。.zwc は _xxx より後に作られていて、mv は mtime を
        # 保つので、.zwc を先に置き換えれば、置き換えの途中でも新しい .zwc が読まれる
        mv -f "${tmp_dir}/${name}.zwc" "${comp_dir}/${name}.zwc"
        mv -f "${tmp_dir}/${name}" "${comp_dir}/${name}"
    else
        rm -f "${comp_dir}/${name}" "${comp_dir}/${name}.zwc"
    fi
}

generate _pup pup completions zsh
generate _task task --completion zsh
generate _temporal temporal completion zsh
generate _gh gh completion -s zsh
generate _mise mise completion zsh
