# CLIProxyAPI（router-for-me/CLIProxyAPI）の設定。claudex（dot_zsh/functions/claudex.zsh）が
# $XDG_CONFIG_HOME/cli-proxy-api/config.yaml として読む。キーの一覧と説明はリリース tarball 同梱の
# config.example.yaml（https://github.com/router-for-me/CLIProxyAPI/blob/main/config.example.yaml）を参照。
#
# ローカルの Claude Code からしか叩かないので、bind は loopback、クライアント認証（api-keys）は無し。
# api-keys が空だと全リクエストを認証無しで通す。Claude Code が送る Authorization: Bearer unused は無視される。
host: "127.0.0.1"
port: 8317

# Codex（ChatGPT サブスク）の OAuth トークンの置き場所。`cli-proxy-api --config <この file> --codex-login` が
# ここに書き、起動中のプロキシは file watcher で変更を拾うので再起動は要らない。CLIProxyAPI は同じディレクトリに
# logs/（リクエストエラーのダンプ）も作る。claudex の serve.log もここに置く。
# 既定は ~/.cli-proxy-api だが、状態ファイルなので XDG_STATE_HOME 配下に寄せる。CLIProxyAPI は ~ しか展開しない
# ため、chezmoi apply 時の XDG_STATE_HOME（未設定なら ~/.local/state）をテンプレートで焼き込む。
# claudex（dot_zsh/functions/claudex.zsh）も同じ値を見る。
auth-dir: "{{ env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local" "state") }}/cli-proxy-api"

# Management API（/v0/management）と管理パネル。secret-key が空なら API 自体が無効（404）。
# パネルは GitHub から自動ダウンロードされるので、使わないものは落としておく。
remote-management:
  allow-remote: false
  secret-key: ""
  disable-control-panel: true

# 動的ライブラリの plugin はプロセス内で動く信頼コード扱いなので有効にしない
plugins:
  enabled: false

debug: false
logging-to-file: false
usage-statistics-enabled: false

# 429 usage_limit_reached を食らうと、CLIProxyAPI は応答本文の resets_at / resets_in_seconds をそのまま cooldown の
# 期限にして（parseCodexRetryAfter が resets_at を優先し、過去なら resets_in_seconds に落ちる）、期限が来るまで
# 上流に投げずにローカルで弾く。usage_limit_reached は hard cooldown 扱いで、期限前に上流へ確認し直す経路は無い
# （一時的な rate_limit_error はリトライ対象として意図的に除外されている）。credential は Codex の OAuth 1 本だけで
# failover 先が無いため、cooldown は待ち時間を有効に使うどころか「ChatGPT 側で枠をリセットしても数十時間 503 を
# 返し続ける」blackout window にしかならない。実際に resets_at が 61 時間先の 429 を 1 回食らい、その後は上流に
# 一切届かず、プロキシがローカルで 10ms 程度で 503 を返す状態が続いた（本物の 429 は上流往復で 1.2 秒かかる）。
# 枠が空いたかどうかは毎回上流に聞かせる。上限中なら 429 がそのまま返るが、それは上流の実状態そのもので正しい。
disable-cooling: true

# Claude Code が Claude の名前で投げてきた場合の逃げ道。claudex は 4 スロットを ANTHROPIC_DEFAULT_*_MODEL で
# Codex モデルに向けているので通常はここを通らないが、素の Claude 名が漏れたときに Codex 側で受けられるようにする。
# 序列は Codex の live カタログ（codex debug models）に合わせて astra > sol > luna。GPT-6 世代に terra は無く、
# sonnet スロットにも sol を当てている（claudex 側のスロット表と揃えること）。
# fork: true で上流名（gpt-6-astra 等）もそのままクライアントに見せる。
oauth-model-alias:
  codex:
    - name: "gpt-6-astra"
      alias: "fable"
      fork: true
    - name: "gpt-6-astra"
      alias: "claude-fable-5-1"
      fork: true
    - name: "gpt-6-astra"
      alias: "claude-fable-5"
      fork: true
    - name: "gpt-6-sol"
      alias: "opus"
      fork: true
    - name: "gpt-6-sol"
      alias: "claude-opus-5-5"
      fork: true
    # 旧 ID。settings.jsonnet の primary は claude-opus-5-5 だが、保存済みセッションや
    # プロジェクト側の settings に残った名前が漏れてきたときの逃げ道として残す
    - name: "gpt-6-sol"
      alias: "claude-opus-5"
      fork: true
    - name: "gpt-6-sol"
      alias: "sonnet"
      fork: true
    - name: "gpt-6-sol"
      alias: "claude-sonnet-5"
      fork: true
    - name: "gpt-6-luna"
      alias: "haiku"
      fork: true
    - name: "gpt-6-luna"
      alias: "claude-haiku-4-5"
      fork: true
    - name: "gpt-6-luna"
      alias: "claude-haiku-4-5-20251001"
      fork: true
    # <model>-fast: Codex の priority tier（カタログの service_tiers: priority。astra は 2x、sol と luna は
    # 1.5x speed、代わりにサブスク usage の減りが早い）で叩くための別名。claudexf / claudeapf が使う。
    # Claude Code の fast mode（fastMode / speed: fast）は Opus 専用で、gpt-* の primary では speed が送られない
    # ことを捕捉サーバーで確認済みなので、モデル名で tier を分け、下の payload.override で service_tier を付ける。
    # claudex が -fast を付けるのは各スロットの既定値だけ（CLAUDEX_*_MODEL で明示した名前には付かない）なので、
    # 要るのは既定の 3 モデル分。
    - name: "gpt-6-astra"
      alias: "gpt-6-astra-fast"
      fork: true
    - name: "gpt-6-sol"
      alias: "gpt-6-sol-fast"
      fork: true
    - name: "gpt-6-luna"
      alias: "gpt-6-luna-fast"
      fork: true

# 上の *-fast 別名で来たリクエストに service_tier: priority を付ける。name はクライアントが指定した名前（別名）と
# 解決後の上流名の両方に対して照合されるので、別名側のパターンで書く。上流に送る payload に
# "service_tier":"priority" が入ることは request-log で確認済み（素の gpt-6-astra では null）。
payload:
  override:
    - models:
        - name: "gpt-*-fast"
          protocol: "codex"
      params:
        service_tier: priority
