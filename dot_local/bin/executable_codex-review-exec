#!/bin/bash
set -euo pipefail

# codex exec ラッパー: プロンプトファイルを受け取り、mktemp で一意な出力ファイルを作成して codex exec に渡す
# Usage:
#   codex-review-exec <prompt-file>
#   codex-review-exec <prompt-file> resume <THREAD_ID>

PROMPT_FILE="$1"
shift
mkdir -p .codex-reviews
TMPFILE=$(mktemp .codex-reviews/codex-review.XXXXXXXXXX)
trap 'echo "OUTPUT_FILE=$TMPFILE"' EXIT
# --sandbox は codex 0.147.0 で削除された --full-auto の後継。
# https://github.com/openai/codex/pull/36054 で `codex exec` から --full-auto が消え、
# sandbox は明示指定が必須になった（それ以前は --full-auto が workspace-write を暗黙指定していた）。
# --full-auto のもう一方の役割だった承認スキップは不要で、`codex exec` は headless のため
# approval_policy を Never に固定する（config.toml の approval_policy は効かない）。
# --sandbox は subcommand 非対応（`codex exec resume --help` に出ない）だが、
# 親コマンド側で解釈されるため resume 経路でも効く。
codex exec --json --sandbox workspace-write -o "$TMPFILE" "$@" - < "$PROMPT_FILE"
