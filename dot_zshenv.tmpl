# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# PATH (静的、サブシェル不要)
export PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq .chezmoi.arch "arm64" }}
export PATH="/opt/homebrew/bin:$PATH"
{{-   else }}
export PATH="/usr/local/bin:$PATH"
{{-   end }}
{{- end }}
# aqua root は home 配下に固定する（環境側の AQUA_ROOT_DIR が書き込み不可な
# パスを指していると aqua install が permission denied で落ちるため）
export AQUA_ROOT_DIR="${XDG_DATA_HOME}/aquaproj-aqua"
export PATH="${AQUA_ROOT_DIR}/bin:$PATH"

# aqua/mise 設定
# .zshenv は入れ子のシェル（tmux のペイン、exec zsh -l 等）のたびに読まれるので、既に入っていれば足さない。
# 無条件に足すと深さごとに値が伸び、この値をキーに含む .zshrc の zoxide init キャッシュが作り直され続ける
_aqua_global_config="${XDG_CONFIG_HOME}/aquaproj-aqua/aqua.yaml"
case ":${AQUA_GLOBAL_CONFIG:-}:" in
    # 既に入っていても export されていない（同じシェルで代入だけされた）ことがあるので export はする
    *":${_aqua_global_config}:"*) export AQUA_GLOBAL_CONFIG ;;
    *) export AQUA_GLOBAL_CONFIG="${AQUA_GLOBAL_CONFIG:+${AQUA_GLOBAL_CONFIG}:}${_aqua_global_config}" ;;
esac
unset _aqua_global_config
export MISE_GLOBAL_CONFIG_FILE="${XDG_CONFIG_HOME}/mise/config.toml"

# Claude Code auto updater を無効化
export CLAUDE_CODE_AUTO_UPDATE=false
export DISABLE_AUTOUPDATER=1

# 1M context 前提の auto-compact 閾値。素の Claude（Opus 5.5[1m]）でも claudex（gpt-6.1-sol の
# 872K）でも model context より小さいので、そのまま閾値として効く
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=750000
