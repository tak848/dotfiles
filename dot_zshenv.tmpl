# XDG Base Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# PATH (静的、サブシェル不要)
export PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq .chezmoi.arch "arm64" }}
export PATH="/opt/homebrew/bin:$PATH"
{{-   else }}
export PATH="/usr/local/bin:$PATH"
{{-   end }}
{{- end }}
# aqua はグローバルのツールには使わず、repo ごとの aqua.yaml のためだけに置いている（aqua CLI は mise で入れる）。
# aqua root は home 配下に固定する（環境側の AQUA_ROOT_DIR が書き込み不可な
# パスを指していると aqua install が permission denied で落ちるため）
export AQUA_ROOT_DIR="${XDG_DATA_HOME}/aquaproj-aqua"
# aqua の bin と mise の shims は、PATH にまだ無いときだけ先頭に足し、mise の shims を aqua の bin より前に置く。
# aqua の bin には過去に aqua で入れていたツール（aws / op / zoxide 等）の aqua-proxy が残り続け、
# そのツールを定義する aqua.yaml が無い場所では command is not found で落ちる。入れ子のシェル（zsh -c や
# zsh のスクリプト）で無条件に先頭へ足し直すと、親のシェルで mise activate が前に並べた mise のツールを
# それらが隠す。親から PATH を受け継がない非ログインシェルでも、mise の shims が先に見つかる。
[[ ":$PATH:" == *":${AQUA_ROOT_DIR}/bin:"* ]] || export PATH="${AQUA_ROOT_DIR}/bin:$PATH"
[[ ":$PATH:" == *":${XDG_DATA_HOME}/mise/shims:"* ]] || export PATH="${XDG_DATA_HOME}/mise/shims:$PATH"

# mise 設定
export MISE_GLOBAL_CONFIG_FILE="${XDG_CONFIG_HOME}/mise/config.toml"

# Claude Code auto updater を無効化
export CLAUDE_CODE_AUTO_UPDATE=false
export DISABLE_AUTOUPDATER=1

# 1M context 前提の auto-compact 閾値。素の Claude（Opus 5.5[1m]）でも claudex（gpt-6.1-sol の
# 872K）でも model context より小さいので、そのまま閾値として効く
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=750000
