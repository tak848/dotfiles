# {{ include "go/cmd/cc-stop-gate/main.go" | sha256sum }}
# {{ include "go/cmd/cc-stop-gate/message.go" | sha256sum }}
# {{ include "go/cmd/cc-stop-gate/decide.go" | sha256sum }}
# {{ include "go/cmd/cc-stop-gate/pause.go" | sha256sum }}
# {{ include "go/cmd/cc-narration-check/main.go" | sha256sum }}
# {{ include "go/cmd/cc-push-guard/main.go" | sha256sum }}
# {{ include "go/cmd/cc-deny-hint/main.go" | sha256sum }}
# {{ include "go/internal/gitstate/gitstate.go" | sha256sum }}
# {{ include "go/internal/gitstate/diagnostic.go" | sha256sum }}
# {{ include "go/internal/gitstate/push_error.go" | sha256sum }}
# {{ include "go/cmd/codex-notification/main.go" | sha256sum }}
# {{ include "go/cmd/cc-check-mojibake/main.go" | sha256sum }}
# {{ include "go/cmd/cc-model-router/main.go" | sha256sum }}
# {{ include "go/cmd/cc-claude-security-source/main.go" | sha256sum }}
# {{ include "go/cmd/cc-claude-security-source/transform.go" | sha256sum }}
# {{ include "go/internal/colors/colors.go" | sha256sum }}
# {{ include "go/internal/render/render.go" | sha256sum }}
# {{ include "go/internal/tts/tts.go" | sha256sum }}
# {{ include "go.mod" | sha256sum }}
# {{ include "go.sum" | sha256sum }}
# Go ソースが変更された時のみビルドする
# このリストの漏れは静かに壊れる（古いバイナリが残り続ける）ため、
# go/cmd/cc-statusline/buildscript_test.go で網羅を検証している。

{{ template "path-setup.tmpl" . }}

# go は 10 の mise install で入る。見つからないときに exit 0 で抜けると chezmoi は成功として記録し、
# Go ソースが変わるまで再実行しないので、異常終了させて次の apply で再試行させる。
if ! command -v go &> /dev/null; then
    echo "エラー: go コマンドが見つかりません。Go バイナリをビルドできません。" >&2
    exit 1
fi

SOURCE_DIR="{{ .chezmoi.sourceDir }}"

mkdir -p ~/.claude/bin ~/.codex/bin

echo "Go バイナリをビルド中..."

go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-statusline ./go/cmd/cc-statusline
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-subagent-statusline ./go/cmd/cc-subagent-statusline
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-post-tool-use ./go/cmd/cc-post-tool-use
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-notification ./go/cmd/cc-notification
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-stop ./go/cmd/cc-stop
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-stop-gate ./go/cmd/cc-stop-gate
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-narration-check ./go/cmd/cc-narration-check
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-push-guard ./go/cmd/cc-push-guard
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-deny-hint ./go/cmd/cc-deny-hint
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-check-mojibake ./go/cmd/cc-check-mojibake
go build -C "$SOURCE_DIR" -o ~/.claude/bin/cc-model-router ./go/cmd/cc-model-router
go build -C "$SOURCE_DIR" -o "$HOME/.claude/bin/cc-claude-security-source" ./go/cmd/cc-claude-security-source
go build -C "$SOURCE_DIR" -o ~/.codex/bin/notification ./go/cmd/codex-notification

echo "Go バイナリのビルド完了"
