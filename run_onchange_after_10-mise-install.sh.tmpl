#!/bin/bash
# {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise の config.toml が変更された時のみ mise install を実行する

{{ template "path-setup.tmpl" . }}

if command -v mise &> /dev/null; then
    # gh auth token があれば MISE_GITHUB_TOKEN を設定（レート制限回避）
    if command -v gh &> /dev/null; then
        token=$(gh auth token 2>/dev/null)
        if [[ -n "$token" ]]; then
            export MISE_GITHUB_TOKEN="$token"
        fi
    fi

    # lazy = true のツールは mise install では入らず、初めて実行したときに入る（config.toml の lazy tools の節）。
    # その入口になる shim は lazy の宣言から作られる。公式ドキュメントは config を手で書き換えたら
    # mise reshim を実行するよう求めているので、lazy の宣言だけが変わったときのために明示的に作り直す。
    echo "mise install を実行中..."
    mise install
    mise reshim
fi
