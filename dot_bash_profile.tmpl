# bash 用のログインシェル設定。
#
# デフォルトシェルを zsh に変えられない環境（chsh が PAM 認証を要求して失敗する
# 自動セットアップ環境など）では、mise / aqua で入れたツールがどのシェルからも
# 見えなくなる。ログイン bash に限ってそれらへ PATH を通すのがこのファイルの目的で、
# 対話利用は想定していないためプロンプト・補完・alias は一切設定しない。
#
# ~/.bash_profile を置くと bash はログイン時に ~/.profile を読まなくなるため、
# ディストリ側の設定を落とさないよう先に明示的に source する
# （Ubuntu の ~/.profile は bash なら ~/.bashrc も読み込む）。
if [ -f "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi

{{ template "path-setup.tmpl" . }}
export MISE_GLOBAL_CONFIG_FILE="${XDG_CONFIG_HOME}/mise/config.toml"
{{- if and (eq .chezmoi.os "darwin") (stat (joinPath .chezmoi.homeDir ".rd/bin")) }}

# Rancher Desktop の PATH 管理（rcfiles モード）は、ログインシェル向けに
# ~/.bash_profile へ下記ブロックを自動追記する。chezmoi 側が同じ内容を持っていないと
# apply のたびに「変更されている」と検出されて上書き確認が出るため、先回りして書いておく。
# Rancher Desktop はマーカー間の内容だけを管理し、一致していれば書き換えない（.zshrc も同じ方式）。
### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="{{ .chezmoi.homeDir }}/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)
{{- end }}
