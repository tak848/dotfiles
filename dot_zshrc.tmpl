# ディレクトリ移動時にls（手動の対話シェル + 実tty出力時のみ。AIエージェント等では抑制）
chpwd() {
    [[ -o interactive && -t 1 ]] || return
    if [[ $(pwd) != $HOME ]]; then;
        ls -la
    fi
}

# mise activate (インタラクティブ用)
# 出力にその時点の PATH が焼き込まれるので、下の init と違ってキャッシュできない
command -v mise &> /dev/null && eval "$(mise activate zsh)"

# ツール連携（init 系）
# 出力をキャッシュして、起動のたびにツールを起動しない（1 つあたり数〜30 ms かかっていた）。
# _zshrc_cached_init <名前> <キーに足す文字列> <コマンド> <引数...>
#   コマンドが PATH に無ければ 1 を返す。あれば、REPLY に eval する文字列（キャッシュを source する文、
#   書き込めなかったときは出力そのもの）を入れる。eval は呼び出し側でトップレベルに置く。関数の中で source
#   すると、読み込んだスクリプトの typeset が関数のローカル変数になるため。
#   キャッシュは「# <キー>」の 1 行目が今のキーと同じ間だけ使う。キーはコマンドの PATH 上のパス・実体の
#   パスと mtime・引数・呼び出し側が足す文字列で、出力を左右するものは全部ここに入れること。
#   mise の backend はバージョンごとに別のパスに入るので、ツールを更新すればキーが変わる
zmodload -F zsh/stat b:zstat
_zshrc_cached_init() {
    local name=$1 extra=$2 cmd=${commands[$3]} cache line out
    local -a st
    shift 2
    [[ -n $cmd ]] || return 1
    zstat -A st +mtime -- ${cmd:A} 2>/dev/null || st=(-)
    local key="v1 $cmd ${cmd:A}:$st[1] ${(q-)@} $extra"
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init/$name.zsh
    if [[ -r $cache ]] && IFS= read -r line < $cache && [[ $line == "# $key" ]]; then
        REPLY="source ${(q)cache}"
        return
    fi
    # 失敗したときはキャッシュせず、従来の eval "$(...)" と同じく出力をそのまま使う
    if ! out=$("$@"); then
        REPLY=$out
        return
    fi
    if mkdir -p -- ${cache:h} && print -r -- "# $key"$'\n'"$out" >| $cache.$$ && mv -f -- $cache.$$ $cache; then
        REPLY="source ${(q)cache}"
    else
        rm -f -- $cache.$$
        REPLY=$out
    fi
}

_zshrc_cached_init direnv '' direnv hook zsh && eval "$REPLY"
# starship は PATH 上の starship のパスを焼き込む（キーの $commands[starship] と同じ）
_zshrc_cached_init starship '' starship init zsh && eval "$REPLY"
_zshrc_cached_init fzf '' fzf --zsh && eval "$REPLY"
# _ZO_ECHO / _ZO_RESOLVE_SYMLINKS は init の出力に焼き込まれる（zoxide の src/cmd/init.rs）
_zshrc_cached_init zoxide "_ZO_ECHO=${_ZO_ECHO-} _ZO_RESOLVE_SYMLINKS=${_ZO_RESOLVE_SYMLINKS-}" zoxide init zsh && eval "$REPLY"
unset -f _zshrc_cached_init

# 補完（pup / task / temporal / mise）
# run_onchange_after_12-zsh-completions が書き出して zcompile したものを、補完を使うときだけ読み込む。
# 起動のたびに生成すると、pup は 3.7MB の eval で 10 秒近く、ほかも起動だけで 1 つあたり 10〜60 ms かかる。
# compinit -C は既存の .zcompdump を信用して fpath の新しいファイルを拾わないので、compdef で直接登録する
_zsh_comp_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions"
if [[ -d $_zsh_comp_dir ]]; then
    fpath=("$_zsh_comp_dir" $fpath)
    for _zsh_comp_cmd in pup task temporal mise; do
        if [[ -r $_zsh_comp_dir/_$_zsh_comp_cmd.zwc ]]; then
            autoload -Uz _$_zsh_comp_cmd
            compdef _$_zsh_comp_cmd $_zsh_comp_cmd
        fi
    done
    unset _zsh_comp_cmd
fi
unset _zsh_comp_dir

# fbr - checkout git branch (including remote branches), sorted by most recent commit, limit 30 last branches
fbr() {
  local branches branch
  branches=$(git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format="%(refname:short)") &&
  branch=$(echo "$branches" |
           fzf --tmux bottom,40% +m) &&
  git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

# プロセスをkill
fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')

  if [ "x$pid" != "x" ]
  then
    echo $pid | xargs kill -${1:-9}
  fi
}

