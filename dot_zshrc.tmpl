# ヒストリーの自動バックアップ（週1回、.local/share に保存）
# 古さは glob qualifier（m+7 は find -mtime +7 と同じ）で調べ、起動のたびに find を起動しない
_zsh_history_backup="${XDG_DATA_HOME:-$HOME/.local/share}/zsh_history_backup"
if [[ -f ~/.zsh_history ]]; then
  _zsh_history_backup_old=( "$_zsh_history_backup"(N.m+7) )
  if [[ ! -f "$_zsh_history_backup" ]] || (( $#_zsh_history_backup_old )); then
    cp ~/.zsh_history "$_zsh_history_backup"
  fi
fi
unset _zsh_history_backup _zsh_history_backup_old

# OPENSPEC:START
fpath=("$HOME/.zsh/completions" $fpath)
# OPENSPEC:END

# compinit キャッシュ化（24時間に1回のみ再構築）
# [[ ]] の中ではファイル名生成が起きず、(#q...) も extended_glob 無しでは使えないので、配列への代入で調べる。
# 以前の [[ -n ~/.zcompdump(#qN.mh+24) ]] は文字列のまま常に真になり、毎回 compaudit 付きで再構築していた。
# compinit は fpath の中身が変わっていなければ .zcompdump を書き直さないので、mtime は自分で更新する
# （しないと、24 時間後からは毎回再構築になる）。compaudit が安全でないディレクトリを見つけて中断したとき
# （端末が無いと確認できずに中断する）は dump が書かれないので、成功したときに既存の dump だけを touch する。
# 空の dump を作ると、次からの compinit -C がそれを読んで compdef すら定義されなくなる
autoload -Uz compinit
_zcompdump_fresh=( "${ZDOTDIR:-$HOME}/.zcompdump"(N.mh-24) )
if (( $#_zcompdump_fresh )); then
  compinit -C
else
  compinit && touch -c -- "${ZDOTDIR:-$HOME}/.zcompdump"
fi
unset _zcompdump_fresh

bindkey -d # キーバインドをリセット
bindkey -e # emacsモードで使う

# ヒストリー
# macOS の /etc/zshrc が HISTSIZE=2000 / SAVEHIST=1000 を代入し、~/.zshenv より後に読まれる。
# .zshenv に書くと対話シェルでは上書きされ、履歴が 1000 件に切り詰められるので、ここで設定する。
# 対話シェルでしか使わないので export しない（子の bash が HISTFILE を引き継いで zsh の履歴に書き込まないように）
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000

# シェルオプション
setopt auto_pushd
setopt pushd_ignore_dups
setopt auto_cd
setopt hist_ignore_dups
setopt share_history
setopt inc_append_history
setopt extended_history     # 実行時間も保存
setopt hist_reduce_blanks   # 余分なスペースを削除してヒストリに保存

